{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Swift Build",
            "type": "shell",
            "command": "swift build --build-tests -Xlinker -debug:dwarf",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "label": "Swift Test",
            "type": "shell",
            "command": "swift test",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": [
                "$msCompile"
            ]
        }
    ]
}
